<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:orientation="vertical"
    android:layout_margin="30sp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40sp"
        android:layout_gravity="center"
        android:layout_marginTop="20sp"
        android:text="Word Manipulator"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="48sp"
        android:layout_marginBottom="20sp"
        android:layout_gravity="right"
        android:text="Transform Your Words "
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58sp"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="10sp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word 1: "
            android:textSize="20sp"
            android:layout_marginRight="10sp"/>
        <!-- Word 1 Input -->
        <EditText
            android:id="@+id/input_word1"
            android:layout_width="match_parent"
            android:layout_height="48sp"
            android:hint="Word 1"
            android:inputType="text"
            android:textSize="18sp"
            android:layout_marginBottom="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58sp"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="10sp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word 2: "
            android:textSize="20sp"
            android:layout_marginRight="10sp"/>
        <!-- Word 1 Input -->
        <EditText
            android:id="@+id/input_word2"
            android:layout_width="match_parent"
            android:layout_height="48sp"
            android:hint="Word 2"
            android:inputType="text"
            android:textSize="18sp"
            android:layout_marginBottom="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58sp"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="10sp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word 3: "
            android:textSize="20sp"
            android:layout_marginRight="10sp"/>
        <!-- Word 1 Input -->
        <EditText
            android:id="@+id/input_word3"
            android:layout_width="match_parent"
            android:layout_height="48sp"
            android:hint="Word 3"
            android:inputType="text"
            android:textSize="18sp"
            android:layout_marginBottom="16sp"/>
    </LinearLayout>


        <!-- Manipulate Button -->
        <Button
            android:id="@+id/button_Manipulate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manipulate Words"

            android:layout_marginTop="20sp"
            android:paddingLeft="24sp"
            android:paddingRight="24sp"
            android:paddingTop="12sp"
            android:paddingBottom="12sp"/>

        <!-- Results Layout -->
        <LinearLayout
            android:id="@+id/resultsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16sp">

            <TextView
                android:id="@+id/textViewOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="8sp"/>

            <TextView
                android:id="@+id/textViewManipulated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="8sp"/>

            <TextView
                android:id="@+id/textViewAcronym"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Reset Button -->
        <Button
            android:id="@+id/button_Reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:paddingLeft="24sp"
            android:paddingRight="24sp"
            android:paddingTop="12sp"
            android:paddingBottom="12sp"
            android:visibility="gone"
            android:layout_marginTop="16sp"/>

</LinearLayout>