<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16sp"
    android:layout_margin="20sp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Drinking Water App"
        android:textSize="24sp"
        android:gravity="center"
        android:paddingBottom="40sp"
        android:textStyle="bold"/>
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="45sp"
        android:text="Enter Water Amount"
        android:textSize="18sp"/>
    <EditText
        android:id="@+id/input_waterAmount"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:hint="Enter amount (ml)"
        android:inputType="number"
        android:layout_marginBottom="16sp"/>

    <Button
        android:id="@+id/add_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add"
        android:layout_marginBottom="16sp"/>

    <TextView
        android:id="@+id/output_totalWater_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Empty"
        android:textSize="16sp"
        android:layout_marginBottom="8sp"/>

    <TextView
        android:id="@+id/output_motivation_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample Text"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/reset_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Water Intake"
        android:layout_gravity="right"
        android:layout_marginBottom="16sp"/>

</LinearLayout>